# =============================================================================
# MCP Research Server — Environment Variables
# =============================================================================
# Copy to .env for local development. On Railway/Render, set these in the dashboard.

# Server port (auto-assigned on Railway/Render)
PORT=3001

# API key to protect your endpoints (set the same value in n8n Header Auth credential)
API_KEY=your-secret-api-key-here

# SEC EDGAR requires a User-Agent with your email
SEC_EDGAR_EMAIL=muhammadfahad.offcl@gmail.com
